# Strata for AMD gfx906 (Instinct MI50 / MI60) - the settings, ready to copy to .env.
#
# One image, two engines: the model's GGUF decides which one runs (strata for Qwen, strata-dsv41 for
# DeepSeek-V4.1-Flash).  Settings marked (Qwen) or (DeepSeek) are read by one engine only; the rest are shared.
#
#   cp m-schenker/gfx906/.env.example m-schenker/gfx906/.env
#   docker compose -f m-schenker/gfx906/docker-compose.yml up -d
#
# docker compose reads .env beside the compose file, so every line below can also be passed in the shell.  Everything
# a variable does is described in m-schenker/gfx906/REFERENCE.md (the guide is README.md).

# ---- where the model is (on the host; mounted read-only at /models) -----------------------------------------------
# Host folder holding the GGUF shards - a Qwen model, or a DeepSeek-V4.1 set.
STRATA_MODEL_DIR=/mnt/models
# Everything the container keeps: run configs, API key, logs, the packs, the MTP runtime.
STRATA_DATA_DIR=${HOME}/.strata/data

# ---- the model ----------------------------------------------------------------------------------------------------
# Empty: the only model under /models.  Several models are not guessed - name the shard 1, or narrow the search.
# MODEL_GGUF=Qwen3.8-Flash-Next-Q8_0-00001-of-00006.gguf
# MODEL_DIR=/models/UD-Q4_K_XL
# Empty: taken from the shard's file name.
MODEL_NAME=
# auto (read the GGUF's architecture), or qwen / ds41 to force one engine.
FAMILY=auto
# Empty: /data/packs/default for a Qwen model, /data/packs/dsv41 for a DeepSeek one.
PACK_DIR=
MTP_DIR=/data/mtp/rt
# (Qwen) empty: the profile the repository ships (data/expert-profile.bin, or -coder.bin for a Coder model).
EXPERT_PROFILE=
# (DeepSeek) extra arguments for tools/dsv41/pack_gguf.py, e.g. for the IST-DAS sets:
#   PACK_ARGS=--engram /models/Engram --engram-meta /models/Engram/meta.gguf --dspark-noise-token 128799 --dspark-markov-rank 256
PACK_ARGS=
# (DeepSeek) a drafter / a vision tower that is not beside the model folder.
DSPARK_GGUF=
MMPROJ=

# ---- the engines --------------------------------------------------------------------------------------------------
# Empty: 32768 for a Qwen model, 8192 for DeepSeek (what its engine was checked at).
CONTEXT=
KV=int8                            # (Qwen)
KV_RESIDENT=                       # (Qwen)
PREFILL=512                        # (Qwen) prompt chunk
SPEC=3                             # (Qwen) drafting depth, needs MTP_DIR
SPEC_MIN_P=0.5                     # (Qwen)
EXPERT_CACHE=auto                  # (Qwen)
VISION=off                         # (DeepSeek) off: the engine's tower has not been run on an MI50
DSPARK=auto                        # (DeepSeek) drafting, when the pack carries the drafter
DSPARK_CONF=                       # (DeepSeek)
PREFILL_CHUNK=                     # (DeepSeek)
TP=                                # (DeepSeek) split each expert's matrix over N cards
VRAM_RESERVE_MIB=1024              # (Qwen --vram-reserve-mib / DeepSeek --reserve-mib)
VRAM_EXPERTS=                      # (DeepSeek) the experts' share of VRAM, in GB
SSD_CACHE=                         # (DeepSeek) the RAM store of experts, in GB (empty: the engine sizes it)
SSD_POLICY=                        # (DeepSeek)
CPU_THREADS=                       # (DeepSeek)
MMAP_EXPERTS=                      # (DeepSeek on/off/auto; a flag on the Qwen engine)
# Empty: every visible card.  "0" pins one, "0,1" uses both.
GPUS=
LAYER_SPLIT=                       # (Qwen, two or more cards)
EXTRA_ARGS=

# ---- the cards ----------------------------------------------------------------------------------------------------
# A hard pin on the host CPUs this container may use.  0-15 is the first 8 physical cores of a 16-core/32-thread
# AMD host; `lscpu -e=CPU,CORE,SOCKET` shows which threads share a core.
CPUSET=0-15
# The cards the runtime may open (both empty: every card in the container).
HIP_VISIBLE_DEVICES=
ROCR_VISIBLE_DEVICES=

# ---- anything else -------------------------------------------------------------------------------------------------
# The server's simultaneous slots (unset: the engine's own).
PARALLEL=
# Empty: 1800 for a Qwen model, 3600 for DeepSeek (a 250-500 GB set is read on a first start).
ENGINE_READY_S=
# 1: write the run config again from these settings at the next start.
STRATA_CONFIG_RESET=0
# (DeepSeek) the windowed decode's mailbox path for windows up to this size.
DS4_ASYNC_T=

# ---- the server ----------------------------------------------------------------------------------------------------
# 127.0.0.1: only this computer.  0.0.0.0 exposes it on the network - an API key is made either way.
STRATA_BIND=127.0.0.1
STRATA_PORT=8080
# Empty: an API key is made on the first start and kept in /data/state/api-key.
STRATA_API_KEY=
NO_API_KEY=0

# ---- gfx906 switches ------------------------------------------------------------------------------------------------
# (Qwen) the two gfx906 attention switches.  ON in this container: they move the QSA attention reduction off the
# shared-memory bounce and onto the card's swizzle operations, and upstream's own bench reports a gain with unchanged
# token ids.  0 turns either off, which is how you compare them on your own cards (gfx906-performance-notes.md).
STRATA_GFX906_ATTN_QUERY_SWIZZLE=1
STRATA_GFX906_ATTN_REDUCE12=1
# (Qwen) the hyper-connection down projection split along K: off, because the sum happens in another order and the
# gain upstream notes is small.  Turn it on and measure if you want to know for your workload.
STRATA_GR_SPLIT=0
STRATA_ARENA_MMAP=0 # for an all-experts-in-VRAM set, together with --pcie-frac 0 in EXTRA_ARGS
STRATA_EXP_MODE=
STRATA_MMVQ_WAVE=
STRATA_ROUTE_PER_TOKEN=
STRATA_GR_FAST=

# ---- rootless Docker ------------------------------------------------------------------------------------------------
# A rootless daemon cannot raise the invoking user's hard RLIMIT_MEMLOCK, and the compose file asks for unlimited so that
# a rootful daemon can pin memory for ROCm. On a rootless box the container then refuses to start at all with:
#   error setting rlimits for ready process: error setting rlimit type 8: operation not permitted
# Set the limit the user already has, in bytes. `ulimit -Hl` prints KiB, so multiply by 1024: 8192 -> 8388608, which is
# the usual rootless default. Leave it empty on a rootful daemon.
MEMLOCK=

# ---- the build ------------------------------------------------------------------------------------------------------
# TheRock's gfx906 tarball (https://nightly.repo.amd.com/rocm/core/tarball/): a nightly is deleted about four months
# after it is built, so a pinned date will stop resolving one day - take a current one when that happens.
ROCM_VERSION=10.3.0a20261027
# Compile jobs: the repository's own recipes use -j2 to -j16.  Fewer if the Docker VM has little memory.  Two engines
# are built here (strata and strata-dsv41), so this step is longer than the Qwen-only image's.
STRATA_BUILD_JOBS=16
