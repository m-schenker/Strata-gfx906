# backend: both (the Qwen engine `strata` and the DeepSeek engine `strata-dsv41`).
#
# REQUIRED for a gfx906 build: without it `ninja strata` stops on src/core/dflash2.cpp, and so does `ninja strata-dsv41`
# (the DeepSeek engine links the same kernels).
#
#   src/core/dflash2.cpp:205:5: error: use of undeclared identifier 'cudaDeviceGetStreamPriorityRange'; did you mean
#   'hipDeviceGetStreamPriorityRange'?
#   src/core/dflash2.cpp:206:9: error: use of undeclared identifier 'cudaStreamCreateWithPriority'; ...
#
# Why: a STRATA_HIP_GFX906 build compiles the CUDA branches of the tree (it defines neither STRATA_USE_HIP nor
# STRATA_GPU_METAL), so every cuda* name those branches use must be mapped by include/strata/platform/hip_compat/.  Two
# newer files - the DFlash2 drafter (src/core/dflash2.cpp) and the 4-bit expert fill's error codes (iq_kernels.cu,
# generate.cpp) - use names the mapping list predates.  include/strata/dsv41/hip_extra.h already maps the priority pair,
# but it is force-included into the DeepSeek-V4.1 target only.
#
# What it adds, all of it 1:1 with a HIP runtime name that exists in ROCm 7.x / TheRock 10.x:
#   cudaDeviceGetStreamPriorityRange / cudaStreamCreateWithPriority   the reported error (dflash2.cpp, and #550's use)
#   cudaErrorInvalidDevice / cudaErrorInvalidValue                   the values nib::prepare() returns (iq_kernels.cu,
#                                                                    generate.cpp)
#   cudaErrorNotSupported / cudaErrorUnknown                         other codes the sources name
#   cudaDevAttrIntegrated, cudaDeviceGetPCIBusId                     device attributes (guarded out today, mapped for
#                                                                    safety: an unused macro costs nothing)
#   cudaOccupancyMaxActiveBlocksPerMultiprocessor                    qsa_select.cu's per-SM CTA count
#   cudaFuncAttributes / cudaFuncGetAttributes                       kernel attribute queries
#   cudaPointerAttributes / cudaPointerGetAttributes, cudaMemoryTypeDevice
#   cudaGraphInstantiateFlagUseNodePriority                          STRATA_GRAPH_PRIO's instantiate flag
#
# Behaviour: no code path changes on NVIDIA (this header is on the include path of the gfx906 build only) and none on
# gfx906 beyond compiling: each line is a macro, so it exists only where the name is already used.  The HIP calls have
# the same signatures as the CUDA ones, so the compiled result is the same call.
#
# Found by a static pass over every cuda* name the gfx906 build compiles (src/*.cu, src/**/*.cpp, include/**/*.hpp),
# with the preprocessor conditions of a gfx906 build applied: 26 names looked unmapped, 11 of them sat in code that
# `#if defined(STRATA_USE_HIP)`, `#if defined(STRATA_HIP_GFX906)`, `#if !defined(__HIPCC__)`, `#if CUDART_VERSION >=
# 13000` or `STRATA_EC_NO_VMM` keep out of this build.  This patch maps the remaining ones that HIP has a counterpart
# for.  It is a compile-time fix only; no measurement.
#
# --- the patch -------------------------------------------------------------------------------------------------
diff --git a/include/strata/platform/hip_compat/strata_hip.h b/include/strata/platform/hip_compat/strata_hip.h
index 180a1f6d..d662046b 100644
--- a/include/strata/platform/hip_compat/strata_hip.h
+++ b/include/strata/platform/hip_compat/strata_hip.h
@@ -76,6 +76,28 @@
 #define cudaDevAttrMemoryClockRate hipDeviceAttributeMemoryClockRate
 #define cudaDevAttrGlobalMemoryBusWidth hipDeviceAttributeMemoryBusWidth
 
+// ---- gfx906: the names the CUDA code paths use that the list above did not cover ------------------------------
+// A STRATA_HIP_GFX906 build compiles the CUDA branches (it defines neither STRATA_USE_HIP nor STRATA_GPU_METAL), so
+// every cuda* name those branches mention has to be mapped here.  These come from src/core/dflash2.cpp (the DFlash2
+// drafter's priority streams), src/kernels/cuda/iq_kernels.cu and src/program/generate.cpp (the error codes the 4-bit
+// fill reports), src/kernels/cuda/qsa_select.cu (the occupancy query) and the pointer/attribute helpers.  A mapping
+// that a given build never reaches costs nothing: it is a macro, expanded only where the name is used.
+#define cudaDeviceGetStreamPriorityRange hipDeviceGetStreamPriorityRange
+#define cudaStreamCreateWithPriority hipStreamCreateWithPriority
+#define cudaErrorInvalidDevice hipErrorInvalidDevice
+#define cudaErrorInvalidValue hipErrorInvalidValue
+#define cudaErrorNotSupported hipErrorNotSupported
+#define cudaErrorUnknown hipErrorUnknown
+#define cudaDevAttrIntegrated hipDeviceAttributeIntegrated
+#define cudaDeviceGetPCIBusId hipDeviceGetPCIBusId
+#define cudaOccupancyMaxActiveBlocksPerMultiprocessor hipOccupancyMaxActiveBlocksPerMultiprocessor
+#define cudaFuncAttributes hipFuncAttributes
+#define cudaFuncGetAttributes hipFuncGetAttributes
+#define cudaPointerAttributes hipPointerAttribute_t
+#define cudaPointerGetAttributes hipPointerGetAttributes
+#define cudaMemoryTypeDevice hipMemoryTypeDevice
+#define cudaGraphInstantiateFlagUseNodePriority hipGraphInstantiateFlagUseNodePriority
+
 // ---- runtime: functions ----------------------------------------------------------------------------------
 #define cudaGetErrorString hipGetErrorString
 #define cudaGetErrorName hipGetErrorName
