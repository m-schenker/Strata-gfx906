# backend: both (kernels shared; the change only fires in a gfx906 build).
#
# Read the trellis weight stream through the global address space on gfx906.
#
# The ISA showed the weight reads going out as `flat_load_ubyte` / `flat_load_ushort` / `flat_load_dword`: the block
# pointers are generic, so clang cannot place them in the global space.  Flat loads are counted by `lgkmcnt`, the same
# counter the LDS codebook lookups wait on, so a wait for a codebook read also waits for HBM reads still in flight and
# the two chains serialise.  Qualifying the three read sites as global (address space 1 is global on AMDGPU) turns them
# into `global_load_*`, which wait on `vmcnt` instead: native_gu_kernel<144> goes from 5 x flat_load to 9 x
# global_load_ushort + 2 x global_load_dword + 1 x global_load_ubyte and a single remaining flat load.
#
# The bytes and their order are untouched, so every sum is bitwise the same (native_expert_bench: 0 differing).
#
# Measured, `native_expert_bench` on the real Gyro-M GGUF, layer 0, reference mode 0, median of three, card exclusive,
# against the same build with patch 0007 (wide codebook staging) and without this one:
#
#   groups x tokens   before (0007 only)   after          delta
#    8 x 1             77.9 / 78.4 us      76.4 us        -2.0 %
#   16 x 1            115.7 / 118.5 us    113.7 us        -2.5 %
#   16 x 2            135.9 / 137.3 us    136.2 us         0.0 %   (a verify window)
#   16 x 4            171.8 / 178.5 us    170.2 us        -2.0 %   (a verify window)
#   32 x 1            200.5 / 204.9 us    202.7 us         0.0 %
#
# This is the discussion document's memory-access item, and it is the second attempt at it in this branch: the first
# annotated only the T=1 read sites and was reverted (+2.8 % on a shape that only occurs when nothing is drafted).  Doing
# it at all three sites, including the scale read, moves the 2-5 token windows as well, which is where `--spec 4` spends
# its calls.  Below the +5 % kernel bar on its own, shipped because it is bitwise, never regresses and removes the
# flat/LDS wait coupling from the hottest kernel.
#
--- a/src/kernels/cuda/iq_kernels.cu
+++ b/src/kernels/cuda/iq_kernels.cu
@@ -643,15 +643,26 @@
 // four.  The same bits either way.
 #if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 610
 #define STRATA_TQ_LD16(p) ((uint32_t) __ldg((const unsigned short*) (p)))
+#elif defined(__HIPCC__) && defined(__gfx906__)
+// gfx906: a pointer the compiler cannot place in the global space is read with `flat_load_*`, and flat loads count
+// against lgkmcnt - so every wait on an LDS read also waits for the HBM reads in flight, and the codebook lookups (which
+// are LDS once staged) end up serialising against the weight stream.  Qualifying these reads as global (address space 1
+// is global on AMDGPU) makes clang emit `global_load_ushort` / `global_load_ubyte` instead, which waits on vmcnt.  The
+// bytes read are the same, the order is the same, so the sums are identical; only which counter the wait uses changes.
+#define STRATA_TQ_LD16(p) ((uint32_t) *(const unsigned short __attribute__((address_space(1))) *) (p))
+#define STRATA_TQ_LD8(p) ((uint32_t) *(const unsigned char __attribute__((address_space(1))) *) (p))
 #else
 #define STRATA_TQ_LD16(p) ((uint32_t) *(p))
+#endif
+#if !defined(STRATA_TQ_LD8)
+#define STRATA_TQ_LD8(p) ((uint32_t) *(p))
 #endif
 template<int TY>
 __device__ __forceinline__ void tq_states4(const uint8_t* qs, int l, uint32_t s[4]) {
     const uint16_t* qs16 = (const uint16_t*) qs;
     if constexpr (TY == 144) {   // s_t = qs[(t + 31) % 32] << 8 | qs[t]
         const uint32_t w01 = STRATA_TQ_LD16(qs16 + 2 * l + 0), w23 = STRATA_TQ_LD16(qs16 + 2 * l + 1);
-        const uint32_t prev = qs[(4 * l + 31) & 31];
+        const uint32_t prev = STRATA_TQ_LD8(qs + ((4 * l + 31) & 31));
         const uint32_t b0 = w01 & 0xFF, b1 = w01 >> 8, b2 = w23 & 0xFF, b3 = w23 >> 8;
         s[0] = (prev << 8) | b0;
         s[1] = (b0 << 8) | b1;
