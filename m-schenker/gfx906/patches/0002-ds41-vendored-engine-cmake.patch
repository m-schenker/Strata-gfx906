# backend: both (the build wiring; the engine it builds is ds41 only)
# 0002 - build the vendored DeepSeek-V4.1 engine (strata-dsv41) beside the Qwen one.
#
# Upstream removed src/dsv41, tools/dsv41 and their CMake targets in v0.2.14 ("DeepSeek out" 1/7..7/7), because the
# engine ships as a signed package for Strata 0.2.13 and earlier.  This container still serves DeepSeek-V4.1-Flash on
# the MI50s, so the engine is vendored: added-source-files/src/dsv41 and added-source-files/tools/dsv41 (v0.2.13's
# tree, MIT, projected from Project Maya's maya-ds4), plus added-source-files/cmake/strata_dsv41.cmake.
#
# Two hunks, both in the build:
#   * CMakeLists.txt calls the vendored module once the gfx906 backend has set up CUDA::cudart / CUDA::cublas, its
#     include directories and strata_prefill (the engine links all three).  The call is skipped when the module is not
#     there, so a tree without this container applies nothing and builds the Qwen engine only.
#   * cmake/strata_ggml.cmake builds ggml-cpu with BMI2 OFF when STRATA_BUILD_DSV41 is on: ggml's IQ1_S / IQ1_M dots
#     use _pdep_u64, which AMD Zen 1/2 run in microcode.  Upstream's dsv41 block did the same, and it went out with
#     the engine.
#
# The engine's own gfx906 changes (no WMMA, no cuda_bf16.h, no __ldcv) are baked into the vendored copy:
# added-source-files/src/dsv41/GFX906-CHANGES.md lists them; they are what patches 0003-0006 were against 0.2.7's tree.
#
# --- the patch -----------------------------------------------------------------------------------------------
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -791,6 +791,14 @@
 # ---- HIP gfx906: every CUDA source of the tree (and the ggml-cuda MMQ sources) is compiled as HIP ----
 strata_hip_gfx906_sources()
 
+# ---- m-schenker/gfx906: the vendored DeepSeek-V4.1 engine (strata-dsv41) ----
+# Upstream removed this engine in v0.2.14.  The sources and this module are shipped by the container
+# (m-schenker/gfx906/added-source-files); apply-source-patches.sh installs them before CMake runs.
+if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/cmake/strata_dsv41.cmake)
+  include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/strata_dsv41.cmake)
+  strata_dsv41_engine()
+endif()
+
 # ---- strata-split: the opt-in engine that splits every layer across 2-4 NVIDIA cards (src/split, from sFNX, MIT, John Fink) ----
 # OFF by default, Linux + CUDA or HIP only, no other target depends on it; see src/split/CMakeLists.txt and docs/SPLIT_ENGINE.md.
 option(STRATA_BUILD_SPLIT "Build strata-split: sFNX's split-every-layer engine, host-memory exchange (Linux, CUDA or HIP gfx1201, 2-4 cards)" OFF)
--- a/cmake/strata_ggml.cmake
+++ b/cmake/strata_ggml.cmake
@@ -34,6 +34,12 @@
     foreach(_f GGML_AVX GGML_AVX2 GGML_FMA GGML_F16C GGML_BMI2)
       set(${_f} ON CACHE BOOL "" FORCE)
     endforeach()
+    # m-schenker/gfx906: the vendored DeepSeek engine builds ggml-cpu with BMI2 OFF, as upstream's own dsv41 block
+    # did: ggml's IQ1_S / IQ1_M dots use _pdep_u64, and AMD Zen 1/2 run PDEP in microcode (1.8 GB/s against 32 GB/s
+    # on an EPYC 7452; the results are bit-identical either way).
+    if(STRATA_BUILD_DSV41)
+      set(GGML_BMI2 OFF CACHE BOOL "" FORCE)
+    endif()
   elseif(STRATA_ISA_FLOOR)
     # the experimental older-CPU build (STRATA_ISA_FLOOR above): one ggml-cpu for the floor, ggml's "sandybridge"
     # feature set (SSE4.2 + AVX) or SSE4.2 alone - not the build host's, which may be newer than the PC it runs on.
