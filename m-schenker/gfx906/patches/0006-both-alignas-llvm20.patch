# backend: both (kernels shared; a compiler-portability fix, no behaviour change and no performance claim).
# clang 20 (distro ROCm 7.1.1 / the ROCm in most distro repos) rejects `__shared__ alignas(16) int4 x[]` in the two
# expdec kernels with "alignas attribute cannot be applied to types"; TheRock 10.3 (clang 24 here) accepts both forms.
# `alignas(16) __shared__ int4 x[]` is accepted by clang 20, by clang 24 and by nvcc, the alignment is identical and the
# code object is the same, so applying it costs nothing and lets the branch build on a distro-ROCm box.  Verified here by
# building native_expert_bench with the patch applied (clang 24, no new warnings) and on a clang-20 box (ROUND4-4XMI50).
diff --git a/src/kernels/cuda/iq_kernels.cu b/src/kernels/cuda/iq_kernels.cu
index d329558..e8c6f7a 100644
--- a/src/kernels/cuda/iq_kernels.cu
+++ b/src/kernels/cuda/iq_kernels.cu
@@ -2590,7 +2590,7 @@ __global__ void __launch_bounds__(256, MINB) expdec_gu_kernel(
                                                                             float* __restrict__ gate, float* __restrict__ up, int rb) {
     const int ng = *n_groups;
     if (blockIdx.y >= ng) return;
-    __shared__ alignas(16) int4 s_u[ED_NC * 2 * ED_XB];
+    alignas(16) __shared__ int4 s_u[ED_NC * 2 * ED_XB];
     __shared__ float s_ds[ED_NC * ED_XB];
     STRATA_SHARED_ALIGN16_U32(s_grid_buf, EdGrid<TG>::words);
     const int tid = threadIdx.x;
@@ -2777,7 +2777,7 @@ __global__ void __launch_bounds__(256, STRATA_EXPDEC_MINB) expdec_down_kernel(co
     if (blockIdx.y >= ng) return;
     constexpr int LANES = TD == 20 ? 8 : 16;
     constexpr int RPP = (256 / LANES) * R;   // rows per pass
-    __shared__ alignas(16) int4 s_u[ED_NC * 2 * ED_HB];
+    alignas(16) __shared__ int4 s_u[ED_NC * 2 * ED_HB];
     __shared__ float s_ds[ED_NC * ED_HB];
     const int tid = threadIdx.x;
     const int sw = tid / LANES, t = tid % LANES;
