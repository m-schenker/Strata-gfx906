# backend: qwen (the Qwen engine `strata` only: the QSA attention it switches on by default is the Qwen path)
# OPTIONAL, not applied by the image: this file sits in m-schenker/gfx906/patches/optional/, and apply-source-patches.sh only takes
# m-schenker/gfx906/patches/*.patch.  To try it, copy it one folder up first:
#
#   cp m-schenker/gfx906/patches/optional/0007-qwen-gfx906-attn-query-swizzle-default.patch m-schenker/gfx906/patches/
#   docker compose -f m-schenker/gfx906/docker-compose.yml build
#
# What it changes: STRATA_GFX906_ATTN_QUERY_SWIZZLE becomes ON unless it is set to "0", "false" or empty.  The engine
# keeps its own guard (the switch applies only on a gfx906 device with a 64-lane wavefront), and the measurement behind
# it is in bench/results/2026-10-08-gfx906-qsa-query-swizzle: +14.6% on the QSA attention component, +1.19% prompt
# throughput and -1.05% latency for one full-model A/B, every token id equal.  One machine, one model, one run per arm.
# It is left off by default because upstream makes it opt-in (docs/AMD_HIP.md); on gfx906 in this image, the switch is
# the only card the guard admits.
#
# Set STRATA_GFX906_ATTN_QUERY_SWIZZLE=0 in the compose environment to turn it back off without rebuilding.
#
# --- the patch -------------------------------------------------------------------------------------------------
diff --git a/src/kernels/cuda/qsa_decode_attn.cu b/src/kernels/cuda/qsa_decode_attn.cu
index fbbef636..f04b1c39 100644
--- a/src/kernels/cuda/qsa_decode_attn.cu
+++ b/src/kernels/cuda/qsa_decode_attn.cu
@@ -964,7 +964,8 @@ void launch_chunks_batch(const float* q, const QsaAttnPools& pools, const int32_
     const bool lane_cell = kernel < 0 && lane_cell_attn();
 #if defined(STRATA_HIP_GFX906)
     static const bool query_swizzle = [] {
-        const char* v = std::getenv("STRATA_GFX906_ATTN_QUERY_SWIZZLE"); return v && v[0] == '1';
+        const char* v = std::getenv("STRATA_GFX906_ATTN_QUERY_SWIZZLE");
+        return v == nullptr ? true : !(v[0] == '0' || v[0] == '\0');   // unset = on; "0", "false" or empty = off
     }();
     const bool use_query_swizzle = kernel < 0 && query_swizzle && !lane_cell && kv_mode == 1 &&
                                    query_swizzle_gfx906_device();
@@ -1092,7 +1093,8 @@ bool qsa_decode_attn_slots(const float* q, const QsaAttnSlotPools& pools, const
 #endif
 #if defined(STRATA_HIP_GFX906)
     static const bool query_swizzle = [] {
-        const char* v = std::getenv("STRATA_GFX906_ATTN_QUERY_SWIZZLE"); return v && v[0] == '1';
+        const char* v = std::getenv("STRATA_GFX906_ATTN_QUERY_SWIZZLE");
+        return v == nullptr ? true : !(v[0] == '0' || v[0] == '\0');   // unset = on; "0", "false" or empty = off
     }();
     if (query_swizzle && !lane_cell && kv_mode == 1 && query_swizzle_gfx906_device()) return false;
 #endif
