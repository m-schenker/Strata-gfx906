         iq_sync_lds();
         return s_buf;
     } else if constexpr (kTqType<TY>) {
-        // the trellis types' int8 codebook: 2048 u16 (4 KB), read by 8 random lookups per 16 weights
-        const uint32_t* src = (const uint32_t*) tq_lut_i8;
-        for (int i = tid; i < 1024; i += nthreads) s_buf[i] = src[i];
+        // the trellis types' int8 codebook: 2048 u16 (4 KB), read by 8 random lookups per 16 weights.  Staged 16 bytes a
+        // thread (256 threads = one pass over the 4 KB) instead of 4: on gfx906 a global load and an LDS store each cost
+        // the address unit a fixed slice regardless of width, so 256 instructions become 64, and the same words land in
+        // the same places (the staging is a copy either way - bitwise identical by construction).
+        static_assert(sizeof(uint32_t) * 1024 == 4096, "the trellis codebook is 4 KB");
+        uint4* dst = (uint4*) s_buf;
+        const uint4* src = (const uint4*) tq_lut_i8;
+        for (int i = tid; i < 256; i += nthreads) dst[i] = src[i];
         __syncthreads();
