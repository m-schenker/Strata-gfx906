# backend: both (kernels shared; the change only fires in a gfx906 build).
#
# NOT SHIPPED - the ISA change works, the reduction is not bitwise identical, and the gain is small or absent.
#
# Replace four of the five `ds_bpermute_b32` of the 32-lane butterfly with `v_mov_b32_dpp row_ror:8/4/2/1` (DPP reads
# the VALU bus, the crossbar shuffle does not; the 16-crossing stays a shuffle because DPP rows are 16 lanes wide).  The
# instruction-level result is what it should be: native_gu_kernel<144> goes from 5 x ds_bpermute_b32 to 4 DPP + 1
# shuffle.
#
# Two findings worth more than the patch itself:
#
#  1. **gfx906 needs two instruction slots between a DPP and the instruction that reads its result.** With no gap, and
#     with one `v_nop`, the same 16-lane butterfly returns 19.0 for a sum of 76.0 and 22.0 for 204.0; with two (or four)
#     gaps it returns 76.0 and 204.0.  A DPP butterfly that looks right on paper silently reads stale register values on
#     this card - very likely why "use DPP for the row reductions" stays a suggestion in the gfx906 forks instead of a
#     shipped change.
#  2. **Parity still fails in the real kernel with the gaps in place.** native_expert_bench reports "NOT BITWISE" on the
#     shapes it finished; the 8 x 1 shape read 75.6-77.8 us against a 79.5 us baseline, i.e. possibly a few percent but
#     unproven and not bitwise, so it cannot ship.  The remaining suspect is the reduce's interaction with masked-out
#     lanes (DPP reads a lane's register whether or not the lane is active), which the XOR shuffle does not have in the
#     same way.
#
# Measured on one MI50 32 GB, `native_expert_bench`, real Gyro-M GGUF, layer 0, card exclusive: baseline 8 x 1 79.5 us,
# 16 x 1 118.8 us.
#
diff --git a/src/kernels/cuda/iq_kernels.cu b/src/kernels/cuda/iq_kernels.cu
index d329558..ea6687e 100644
--- a/src/kernels/cuda/iq_kernels.cu
+++ b/src/kernels/cuda/iq_kernels.cu
@@ -862,10 +862,45 @@ STRATA_TQP_FMT(149)
 template<> struct Fmt<40> { static constexpr int qk = 64, ipb = 2, step = 4;     // NVFP4: 2 calls of 32 values
     __device__ static float dot(const void* v, const block_q8_1* y, int kbx, int iqs) { return vec_dot_nvfp4_q8_1(v, y, kbx, iqs); } };
 
+// The 32-lane butterfly.  `__shfl_xor_sync` becomes a `ds_bpermute_b32` on gfx906, i.e. five trips through the LDS
+// crossbar per reduction; a 32-lane wave also has DPP row shuffles, which read the VALU bus instead (measured ~1778
+// against ~906 Gxchg/s on this card).  DPP's row modes are 16 lanes wide, so the 16-crossing stays a crossbar shuffle
+// and the four steps inside a row are `v_mov_b32_dpp row_ror:` - the same pairs as the XOR butterfly, in the same
+// order, hence the same sums bit for bit (float addition is not associative; the tree has to match, not just the set).
+//
+// The catch, learned on hardware: a DPP whose source is written by the immediately preceding instruction reads the
+// *stale* value - one gap is not enough, two are (a probe with 15-lane patterns: 0 gaps and 1 gap both give 19.0 for a
+// sum of 76.0, 2 and 4 gaps give 76.0).  So each DPP step here is followed by two `v_nop`s, which is why the win is
+// -3 mod-16..mod-1... and why this only pays where the reduction sits in a loop: in `native_gu_kernel<144>` five
+// `ds_bpermute_b32` per dot call go to one shuffle plus four DPP, and the nops fill slots that the LDS crossbar was
+// holding anyway.  STRATA_DPP_SUM=0 at build time restores the shuffle-only version.
+#if defined(__HIPCC__) && defined(__gfx906__) && !defined(STRATA_DPP_SUM)
+#define STRATA_DPP_SUM 1
+#endif
+
+#if STRATA_DPP_SUM
+// the two gaps the hardware needs between a DPP result and the next DPP that reads it
+#define STRATA_DPP_GAP() asm volatile("v_nop\n\tv_nop" ::: "memory")
+#define STRATA_DPP_ROR(N) __device__ __forceinline__ float strata_dpp_ror##N(float v) { \
+    float o; asm volatile("v_mov_b32_dpp %0, %1 row_ror:" #N " row_mask:0xf bank_mask:0xf" : "=&v"(o) : "v"(v)); \
+    return o; }
+STRATA_DPP_ROR(1) STRATA_DPP_ROR(2) STRATA_DPP_ROR(4) STRATA_DPP_ROR(8)
+#undef STRATA_DPP_ROR
+#endif
+
 __device__ __forceinline__ float warp_sum(float v) {
+#if STRATA_DPP_SUM
+    v += __shfl_xor_sync(0xffffffffu, v, 16);        // across the two 16-lane DPP rows: still the crossbar
+    v += strata_dpp_ror8(v); STRATA_DPP_GAP();
+    v += strata_dpp_ror4(v); STRATA_DPP_GAP();
+    v += strata_dpp_ror2(v); STRATA_DPP_GAP();
+    v += strata_dpp_ror1(v);
+    return v;
+#else
 #pragma unroll
     for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
     return v;
+#endif
 }
 
 // One row against one q8_1 activation, the whole warp: call k = (block, part) is lane-strided.
