# backend: both (the hyper-connection read is shared; nothing here is gfx906-specific).
#
# NOT SHIPPED - measured, and it does not help.
#
# fused_gr_read_multi() returns whether it left the q8_1 image of `mixed` behind; when it does not, the caller runs
# native_quantize_q8_1 over `mixed` itself (mtp.cpp / verify.cpp / layer.cpp: `if (!q8) quantize`).  The gfx906
# STRATA_GR_SPLIT=1 path launches gr_up_fast_kernel / gr_up_multi_kernel - both of which end in
# `if (m.a[0].q8_mixed != nullptr) gr_q8_tail(m, d0)` - and then returns `false`, so the activation looked like it was
# quantised twice: once in the up kernel, once by the caller.  This patch returns `q8` instead, skipping the second pass.
#
# Measured (the first engine-level A/B in this branch that could be run at all, `bench/gfx906_tg_probe.sh`, 5 and 4 reps,
# both arms from the same build tree with the shipped patches, both with STRATA_GR_SPLIT=1, `ninja strata` + the binary
# swapped into the serving container, correct output in both arms - 40 tokens on the same prompt):
#
#   without this patch   67.4 tok/s
#   with this patch      50.8 tok/s
#
# So removing the pass is at best eaten by something else in the chain and at worst a regression; the medians are noisy on
# this card (single reps ranged 50-197 tok/s), but there is no measurement in favour of the change, and the second
# quantisation writes the same bytes to the same place, so it was never a correctness problem.  Kept out.
#
diff --git a/src/kernels/cuda/fused_gr.cu b/src/kernels/cuda/fused_gr.cu
index 1c3d4df..1cf41ea 100644
--- a/src/kernels/cuda/fused_gr.cu
+++ b/src/kernels/cuda/fused_gr.cu
@@ -2981,7 +2981,12 @@ static bool fused_gr_read_multi_slice(const FusedGrArgs* a, int n_tok, float* xn
             std::fprintf(stderr, "fused_gr_read_multi: %s\n", cudaGetErrorString(e));
             std::exit(1);
         }
-        return false;   // the gfx906 STRATA_GR_SPLIT read: no q8_1 (the caller quantizes), like the v3 path above
+        // Both up kernels of this path write the q8_1 image themselves (gr_up_fast_kernel and gr_up_multi_kernel end
+        // in `if (m.a[0].q8_mixed != nullptr) gr_q8_tail(m, d0)`), so reporting "no image" here made the caller run
+        // native_quantize_q8_1 over mixed_ a second time - a whole extra pass over N*T values per hyper-connection
+        // read, on the activations the next GEMV consumes.  It is `false` only when no image was asked for, which is
+        // what `q8` already says; the v3 path above is a different case (gr_up_v3_kernel has no tail).
+        return q8;
     }
 #endif
     // the default read (STRATA_GR_V3 unset): v1, or the bitwise-equal v2 / v3 this card's check accepted
