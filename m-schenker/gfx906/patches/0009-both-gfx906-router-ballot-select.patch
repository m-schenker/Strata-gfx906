+__device__ int g_router_ballot_dev = 1;   // STRATA_ROUTER_BALLOT=0: the two-reduction selection, for A/B
+// One reduction per rank instead of two.  The reduction does not need the id: after the 5-shuffle max every lane
+// knows the winning VALUE, the lane owning it knows which slot it came from, and a ballot detects the rare case where
+// several lanes hold that value - the only case that has to break a tie, and so the only case that needs an id reduce.
+// That halves the shuffles a call issues (10 per rank -> 5) with the same exact float comparisons, so the ids and the
+// weights come out bitwise what the two-reduction loop produced (tools/hip/gfx906_router_lab.cpp checks that, including
+// a logits set made entirely of exact ties).  Written as a select-and-accumulate so all three shapes - the 512/10
+// single-token route, its multi-token twin and the generic NE/K template - share it.
+template <int K, int V>
+__device__ __forceinline__ void select_ranks(float (&values)[V], int32_t* __restrict__ ids, int lane,
+                                             float& selected, float& selected_sum) {
+    const bool ballot = g_router_ballot_dev != 0;
+    for (int rank = 0; rank < K; ++rank) {
+        float best = values[0];
+        int slot = 0;
+#pragma unroll
+        for (int i = 1; i < V; ++i) {
+            if (values[i] > best) { best = values[i]; slot = i; }
+        }
+        if (ballot) {
+#pragma unroll
+            for (int mask = 16; mask; mask >>= 1) best = fmaxf(best, __shfl_xor_sync(0xffffffffu, best, mask, 32));
+            const bool hit = (values[slot] == best);
+            const int cand = lane + slot * 32;
+            int winner = hit ? cand : 0x7FFFFFFF;
+            if (__popc(__ballot_sync(0xffffffffu, hit)) > 1) {   // rare, and uniform across the warp
+#pragma unroll
+                for (int mask = 16; mask; mask >>= 1)
+                    winner = min(winner, __shfl_xor_sync(0xffffffffu, winner, mask, 32));
+            }
+            if (hit && cand == winner) {
+                ids[rank] = cand;
+                values[slot] = -INFINITY;
+                selected_sum += best;   // accumulated by the winning expert's lane, as before
+            }
+        } else {
+            int expert = lane + slot * 32;
+#pragma unroll
+            for (int mask = 16; mask; mask >>= 1) {
+                const float other = __shfl_xor_sync(0xffffffffu, best, mask, 32);
+                const int other_id = __shfl_xor_sync(0xffffffffu, expert, mask, 32);
+                if (other > best || (other == best && other_id < expert)) { best = other; expert = other_id; }
+            }
+            if ((expert & 31) == lane) {
+                values[expert / 32] = -INFINITY;
+                ids[rank] = expert;
+                selected_sum += best;
+            }
+        }
+        if (rank == lane) selected = best;
+    }
+}
