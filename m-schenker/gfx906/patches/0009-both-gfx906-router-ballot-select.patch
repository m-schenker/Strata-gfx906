+inline void router_ballot_init() {
+    static bool once = false;
+    if (once) return;
+    once = true;
+    const char* v = std::getenv("STRATA_ROUTER_BALLOT");
+    const int on = !(v && v[0] == '0');
+    cudaMemcpyToSymbol(g_router_ballot_dev, &on, sizeof(on));
+}
+void native_router_set_enabled(bool value) {
+    router_ballot_init();   // engine start-up: a symbol write inside a captured launch breaks the HIP graph
+    enabled.store(value, std::memory_order_relaxed);
+}
 bool native_router_enabled() { return enabled.load(std::memory_order_relaxed); }
